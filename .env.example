APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg2://eq_user:eq_pass@postgres:5432/eq_db
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

UPLOAD_DIR=storage/uploads
REPORT_DIR=storage/reports
OPENFACE_BINARY=/opt/openface/build/bin/FeatureExtraction
OPENFACE_OUTPUT_DIR=artifacts/openface
TARGET_FPS=25
WINDOW_SIZE_FRAMES=75
WINDOW_STRIDE_FRAMES=25
STAGE2_CHECKPOINT_PATH=artifacts/checkpoints/stage2_resnet.pt
STAGE3_CHECKPOINT_PATH=artifacts/checkpoints/stage3_bilstm.pt
STAGE5_CHECKPOINT_PATH=artifacts/checkpoints/stage5_bayes.pt
INFERENCE_DEVICE=cpu
INFERENCE_BATCH_SIZE=8
STAGE5_MC_PASSES=50
